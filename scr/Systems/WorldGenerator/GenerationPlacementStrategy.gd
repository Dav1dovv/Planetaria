extends Resource
class_name GenerationPlacementStrategy

# ═══════════════════════════════════════════════════════════════════════════════
#  GenerationPlacementStrategy — базовый класс для "стратегий расстановки".
#
#  Идея: WorldMapGenerator больше не решает САМ, КАК предлагать точки для
#  объектов (случайно / по сетке / как-то ещё) — он просто просит у стратегии
#  список точек-кандидатов, а сам занимается тем, что ОДИНАКОВО для любой
#  стратегии: проверка попадания в полигон области, спейсинг между объектами,
#  harvested-фильтр, клиренс от структур, выбор конкретного ресурса по весам.
#
#  Чтобы добавить свой способ расстановки (например Poisson-disc или
#  расстановку вдоль путей) — создай новый .gd, extends этот класс,
#  переопредели generate_candidates(), и назначь ресурс в инспекторе
#  в поле resource_placement_strategy у WorldMapGenerator. Менять сам
#  WorldMapGenerator для этого не нужно.
# ═══════════════════════════════════════════════════════════════════════════════

## Вызывается один раз перед generate_candidates(). location_seed передаётся,
## чтобы стратегия могла завести свой детерминированный шум/RNG, не путаясь
## с шумом зон или общим _rng генератора.
func setup(_area_polygon: PackedVector2Array, _area_rect: Rect2, _location_seed: int) -> void:
	pass


## Возвращает список точек-кандидатов в мировых координатах. WorldMapGenerator
## пройдётся по ним по порядку и отфильтрует непригодные (вне полигона, слишком
## близко к другому объекту/структуре, уже harvested и т.п.) — эту фильтрацию
## реализовывать здесь не нужно, она общая для всех стратегий.
func generate_candidates(_rng: RandomNumberGenerator) -> Array[Vector2]:
	push_error("[GenerationPlacementStrategy] generate_candidates() не переопределён в %s" % get_class())
	return []


## true, если стратегия сама решает, СКОЛЬКО объектов в итоге появится
## (например через порог шума плотности на сетке) — тогда WorldMapGenerator
## не будет останавливаться на каком-то заранее заданном числе, а разместит
## все прошедшие проверки кандидаты. false — если у стратегии есть чёткое
## желаемое количество (см. get_target_count()).
func is_count_emergent() -> bool:
	return false


## Желаемое количество объектов. Имеет смысл только когда is_count_emergent()
## возвращает false. -1 = "без ограничения" даже для не-эмерджентной стратегии.
func get_target_count() -> int:
	return -1
