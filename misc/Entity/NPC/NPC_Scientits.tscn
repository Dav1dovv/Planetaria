raw_text = "~ start
Bern: [[Если найдёшь медь — приноси. Не найдешь — тоже приходи, работы у меня всегда больше чем рук|Медь хорош! но еще лучше работать с золотом|Ковать оружие интереснее чем что то другое|Во имени Элара что это у тебя там блестит|Мой отец говорил: металл терпит грубость один раз. Второй раз он терпит тебя, а не то, что ты куёшь.|Метал очень важен не только для орудий он еще и для организма у нас тоже есть металл внутри.|Золото звенит красиво, но железо служит дольше. Запомни это, если выбираешь между красивым и нужным|Во имя Элара, ты опять притащил что-то, что светится. Клади на стол, только не рядом с горном]].
- Крафт
	do Global.inventory.call_workbench()
	Bern: приходи еше.
- нечего
	=> END
"
metadata/dialogue_manager_version = "3.10.5"

